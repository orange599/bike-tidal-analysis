# 复制为 .env 后按需修改。Docker Compose 会自动读取本文件。
# 以下默认值只适用于本机 Docker 演示环境，公开部署前请务必修改。

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bike_db
MYSQL_USER=bike
MYSQL_PASSWORD=local_demo_only

# Python 服务如需覆盖，请在启动前 export 同名环境变量：
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DB=bike_db
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP=localhost:9092
# KAFKA_TOPIC=bike_events
